# Lattice sandbox credentials (from https://developer.anduril.com/guides/getting-started/sandboxes)
LATTICE_URL=https://<sandbox-name>.anduril.com
LATTICE_CLIENT_ID=<your-client-id>
LATTICE_CLIENT_SECRET=<your-client-secret>
SANDBOX_TOKEN=<your-sandbox-token>

# Neo4j connection (default: local docker-compose)
NEO4J_URL=neo4j://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
